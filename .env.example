# ============================================================
#  Environment variables for the MAUDE Orthopedic Dashboard
#  Copy this file, fill in real values, and NEVER commit the copy.
#    - ingester (Python):   copy to  ingester/.env
#    - web app (Next.js):   copy to  .env.local   (project root)
# ============================================================

# ---- openFDA (ingester only) ----
OPENFDA_API_KEY=your_openfda_key_here

# ---- Supabase, server-side (ingester) ----
# Uses the SECRET key: full write access. Server-side ONLY.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your_secret_key_here

# ---- Supabase, browser-side (Next.js web app) ----
# The web app runs in the browser, so it must use the PUBLISHABLE key
# plus Row Level Security. NEVER put the secret key in these.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here
